<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\FluxRAM.ico</ApplicationIcon>
    <RootNamespace>FluxRAM.App</RootNamespace>
    <AssemblyName>FluxRAM.App</AssemblyName>
    <Version>0.4.1</Version>
    <AssemblyVersion>0.4.1.0</AssemblyVersion>
    <FileVersion>0.4.1.0</FileVersion>
    <InformationalVersion>0.4.1</InformationalVersion>
    <Product>FluxRAM</Product>
    <FluxRAMDistributionMode Condition="'$(FluxRAMDistributionMode)' == ''">Lite</FluxRAMDistributionMode>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="FluxRAMDistributionMode" Value="$(FluxRAMDistributionMode)" />
    <Resource Include="..\..\FluxRAM.ico" Link="FluxRAM.ico" />
    <Resource Include="Assets\PurchasePro\*.jpg" />
    <ProjectReference Include="..\FluxRAM.Core\FluxRAM.Core.csproj" />
  </ItemGroup>
</Project>
