<Window x:Class="FluxRAM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluxRAM"
        Width="720"
        Height="380"
        MinWidth="720"
        MinHeight="380"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="FluxRAM.ico"
        FontFamily="Segoe UI"
        Background="#0E1117"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <Window.Resources>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E1117" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#121821" />
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#0D131A" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#243244" />
    <SolidColorBrush x:Key="InsetBorderBrush" Color="#243040" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F7FB" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D8E2F0" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#C4D0E2" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3DD6A3" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#18362B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F7C873" />
    <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="#0D141D" />
    <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#516B8D" />
    <SolidColorBrush x:Key="ComboBoxForegroundBrush" Color="#17202C" />
    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#EFF5FB" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#CAD5E2" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#1B2531" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#304156" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#223044" />
    <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#526A84" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#192331" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#3DD6A3" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#7BE8BC" />
    <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#06130D" />
    <SolidColorBrush x:Key="QuietButtonBackgroundBrush" Color="#151E29" />
    <SolidColorBrush x:Key="QuietButtonBorderBrush" Color="#2D3A49" />
    <SolidColorBrush x:Key="IconButtonBackgroundBrush" Color="#101923" />
    <SolidColorBrush x:Key="IconButtonBorderBrush" Color="#4B6280" />
    <SolidColorBrush x:Key="ToggleBackgroundBrush" Color="#1B2531" />
    <SolidColorBrush x:Key="ToggleBorderBrush" Color="#304156" />
    <SolidColorBrush x:Key="ToggleHoverBorderBrush" Color="#5C7087" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#253A31" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="#202B38" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#0E1117" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#3A4A5F" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#526A84" />
    <SolidColorBrush x:Key="IconTileBackgroundBrush" Color="#0D141D" />
    <SolidColorBrush x:Key="IconTileBorderBrush" Color="#2E3B4C" />
    <SolidColorBrush x:Key="EditionBadgeBorderBrush" Color="#315E4B" />
    <SolidColorBrush x:Key="EditionBadgeTextBrush" Color="#9FF0C9" />

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="InsetPanelStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource InsetBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="CaptionStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ValueStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style x:Key="MetricLineStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueStyle}">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Foreground" Value="{DynamicResource ComboBoxForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="BaseButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}" />
    </Style>

    <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Background" Value="{DynamicResource QuietButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QuietButtonBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{DynamicResource IconButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />

    <Style x:Key="ToggleBoostStyle" TargetType="ToggleButton">
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource ToggleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToggleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ToggleRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    SnapsToDevicePixels="True">
              <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ToggleDot"
                        Width="8"
                        Height="8"
                        CornerRadius="4"
                        Background="{DynamicResource TextMutedBrush}"
                        VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="1"
                                  Margin="9,0,0,0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleRoot" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="ToggleDot" Property="Background" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="{DynamicResource ToggleHoverBorderBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemRoot"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource ListItemSelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource ListItemHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Background" Value="{DynamicResource ScrollBarTrackBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track"
                     IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand"
                                Focusable="False"
                                Opacity="0" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb x:Name="ScrollThumb">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbRoot"
                                Margin="2"
                                CornerRadius="4"
                                Background="{DynamicResource ScrollBarThumbBrush}" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbRoot" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand"
                                Focusable="False"
                                Opacity="0" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="12" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="12" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="78" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="78" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Width="42"
                  Height="42"
                  CornerRadius="8"
                  Background="{DynamicResource IconTileBackgroundBrush}"
                  BorderBrush="{DynamicResource IconTileBorderBrush}"
                  BorderThickness="1">
            <Image Source="FluxRAM.ico"
                   Width="28"
                   Height="28"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
          </Border>

          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="AppTitleTextBlock"
                         FontSize="22"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Text="FluxRAM" />
              <Border Margin="9,2,0,0"
                      Padding="8,2"
                      Height="24"
                      CornerRadius="6"
                      Background="{DynamicResource AccentSoftBrush}"
                      BorderBrush="{DynamicResource EditionBadgeBorderBrush}"
                      BorderThickness="1">
                <TextBlock x:Name="EditionValueTextBlock"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource EditionBadgeTextBrush}"
                           VerticalAlignment="Center"
                           Text="FluxRAM" />
              </Border>
            </StackPanel>
            <TextBlock x:Name="AppSubtitleTextBlock"
                       Margin="0,3,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Boost-first memory tool" />
          </StackPanel>

          <Button x:Name="DetailSettingsButton"
                  Grid.Column="4"
                  Height="30"
                  Style="{StaticResource QuietButtonStyle}"
                  Content="Details"
                  Click="DetailSettingsButton_OnClick" />
          <Button x:Name="ThemeToggleButton"
                  Grid.Column="6"
                  Height="30"
                  Style="{StaticResource QuietButtonStyle}"
                  Content="Light"
                  Click="ThemeToggleButton_OnClick" />
          <Button x:Name="MinimizeButton"
                  Grid.Column="8"
                  Height="30"
                  Style="{StaticResource QuietButtonStyle}"
                  Content="Minimize"
                  Click="MinimizeButton_OnClick" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource InsetPanelStyle}" Padding="9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="StatusCaptionTextBlock" Style="{StaticResource CaptionStyle}" Text="STATUS" />
              <TextBlock Margin="0,4,0,0"
                         FontSize="13"
                         FontWeight="Regular"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextWrapping="Wrap"
                         Text="{Binding StatusMessage}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock x:Name="RuntimeSummaryTitleTextBlock" Style="{StaticResource CaptionStyle}" Text="RUNTIME SUMMARY" />
              <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding AutoBoostDisplay}" />
              <TextBlock Margin="0,2,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding ReboundRateDisplay}" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ProfileCaptionTextBlock"
                         VerticalAlignment="Center"
                         Style="{StaticResource CaptionStyle}"
                         Text="PROFILE" />
              <Button x:Name="ProfileHelpButton"
                      Margin="6,0,0,0"
                      VerticalAlignment="Center"
                      Style="{StaticResource IconButtonStyle}"
                      Content="?"
                      ToolTip="Profile details"
                      Click="ProfileHelpButton_OnClick" />
            </StackPanel>
            <ComboBox x:Name="ProfileSelector"
                      Margin="0,4,0,0"
                      SelectionChanged="ProfileSelector_OnSelectionChanged">
              <ComboBoxItem x:Name="ConservativeProfileItem" Tag="Conservative" Content="Light" />
              <ComboBoxItem x:Name="BalancedProfileItem" Tag="Balanced" Content="Standard" />
              <ComboBoxItem x:Name="AggressiveProfileItem"
                            Tag="Aggressive"
                            Content="Extreme Performance"
                            Visibility="Collapsed" />
            </ComboBox>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock x:Name="LanguageCaptionTextBlock" Style="{StaticResource CaptionStyle}" Text="LANGUAGE" />
            <ComboBox x:Name="LanguageSelector"
                      Margin="0,4,0,0"
                      SelectionChanged="LanguageSelector_OnSelectionChanged">
              <ComboBoxItem x:Name="LanguageEnglishItem" Tag="en" Content="English" />
              <ComboBoxItem x:Name="LanguageChineseSimplifiedItem" Tag="zh-CN" Content="简体中文" />
              <ComboBoxItem x:Name="LanguageChineseTraditionalItem" Tag="zh-TW" Content="繁體中文" />
              <ComboBoxItem x:Name="LanguageJapaneseItem" Tag="ja" Content="日本語" />
              <ComboBoxItem x:Name="LanguageKoreanItem" Tag="ko" Content="한국어" />
            </ComboBox>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button x:Name="BoostNowButton"
                  Grid.Column="0"
                  Height="44"
                  FontSize="14"
                  FontWeight="Bold"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Content="Boost Now"
                  Click="BoostNowButton_OnClick" />
          <ToggleButton x:Name="AutoBoostToggle"
                        Grid.Column="2"
                        Style="{StaticResource ToggleBoostStyle}"
                        Content="Auto Boost"
                        Checked="AutoBoostToggle_OnChecked"
                        Unchecked="AutoBoostToggle_OnUnchecked" />
        </Grid>
      </Grid>
    </Border>

    <ScrollViewer x:Name="DetailPanel"
                  Grid.Row="2"
                  Visibility="Collapsed"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
      <Grid MinHeight="500">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.15*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="1.05*" />
          <RowDefinition Height="12" />
          <RowDefinition Height="0.95*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0"
                        Grid.Column="0">
              <TextBlock x:Name="ProtectListTitleTextBlock"
                         Style="{StaticResource SectionTitleStyle}"
                         Text="Protected Apps" />
              <TextBlock x:Name="ProtectionModeTextBlock"
                         Margin="0,3,8,0"
                         FontSize="12"
                         FontWeight="Regular"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <WrapPanel Grid.Row="0"
                       Grid.Column="1"
                       HorizontalAlignment="Right">
              <Button x:Name="AddProtectedAppButton"
                      Width="80"
                      Content="Add EXE"
                      Click="AddProtectedAppButton_OnClick" />
              <Button x:Name="AddRunningProtectedAppButton"
                      Width="104"
                      Margin="6,0,0,0"
                      Content="Running App"
                      Click="AddRunningProtectedAppButton_OnClick" />
              <Button x:Name="RemoveProtectedAppButton"
                      Width="92"
                      Margin="6,0,0,0"
                      Content="Remove"
                      Click="RemoveProtectedAppButton_OnClick" />
            </WrapPanel>

            <Border x:Name="ProtectListEditorBorder"
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource InsetPanelStyle}"
                    Padding="6">
              <ListBox x:Name="ProtectedAppsListBox"
                       ItemsSource="{Binding ProtectedEntries}"
                       SelectionMode="Extended"
                       SelectionChanged="ProtectedAppsListBox_OnSelectionChanged"
                       FontFamily="Consolas"
                       FontSize="11" />
            </Border>

            <Border x:Name="ProtectListLockedBorder"
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource InsetPanelStyle}"
                    Visibility="Collapsed">
              <TextBlock x:Name="ProtectListLockedTextBlock"
                         Margin="16"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         Text="Pro edition unlocks app protection." />
            </Border>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="MemoryMetricsTitleTextBlock" Style="{StaticResource SectionTitleStyle}" Text="Memory Metrics" />

            <UniformGrid Grid.Row="2" Columns="2" Rows="3" Margin="0,2,0,0">
              <StackPanel Margin="0,0,18,0">
                <TextBlock x:Name="RamDeltaCaptionTextBlock" Visibility="Collapsed" />
                <TextBlock x:Name="RamDeltaValueTextBlock"
                           Style="{StaticResource MetricLineStyle}"
                           Text="N/A" />
              </StackPanel>

              <StackPanel>
                <TextBlock x:Name="AvailableCaptionTextBlock" Visibility="Collapsed" />
                <TextBlock x:Name="AvailableValueTextBlock"
                           Style="{StaticResource MetricLineStyle}"
                           Text="N/A" />
              </StackPanel>

              <StackPanel Margin="0,0,18,0">
                <TextBlock x:Name="LastBoostTrimmedCaptionTextBlock" Visibility="Collapsed" />
                <TextBlock x:Name="LastBoostTrimmedValueTextBlock"
                           Style="{StaticResource MetricLineStyle}"
                           Text="N/A" />
              </StackPanel>

              <StackPanel>
                <TextBlock x:Name="TotalTrimmedCaptionTextBlock" Visibility="Collapsed" />
                <TextBlock x:Name="TotalTrimmedValueTextBlock"
                           Style="{StaticResource MetricLineStyle}"
                           Text="N/A" />
              </StackPanel>

              <StackPanel Margin="0,0,18,0">
                <TextBlock x:Name="BoostNetGainCaptionTextBlock" Visibility="Collapsed" />
                <TextBlock x:Name="BoostNetGainValueTextBlock"
                           Style="{StaticResource MetricLineStyle}"
                           Text="N/A" />
              </StackPanel>

              <StackPanel>
                <TextBlock x:Name="SelfOverheadCaptionTextBlock" Visibility="Collapsed" />
                <TextBlock Style="{StaticResource MetricLineStyle}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding SelfOverheadDisplay}" />
              </StackPanel>
            </UniformGrid>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="12" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="12" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="5" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Orientation="Horizontal">
              <TextBlock x:Name="EditionCaptionTextBlock"
                         VerticalAlignment="Center"
                         Style="{StaticResource CaptionStyle}"
                         Text="EDITION" />
              <Button x:Name="EditionHelpButton"
                      Margin="6,0,0,0"
                      VerticalAlignment="Center"
                      Style="{StaticResource IconButtonStyle}"
                      Content="?"
                      ToolTip="Edition details"
                      Click="EditionHelpButton_OnClick" />
            </StackPanel>

            <TextBlock x:Name="MachineIdCaptionTextBlock"
                       Grid.Row="2"
                       Grid.ColumnSpan="3"
                       Style="{StaticResource CaptionStyle}"
                       Text="MACHINE ID" />
            <TextBox x:Name="MachineIdTextBox"
                     Grid.Row="4"
                     Grid.Column="0"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="11" />
            <Button x:Name="CopyMachineIdButton"
                    Grid.Row="4"
                    Grid.Column="2"
                    Content="Copy"
                    Click="CopyMachineIdButton_OnClick" />

            <TextBlock x:Name="LicenseKeyCaptionTextBlock"
                       Grid.Row="6"
                       Grid.ColumnSpan="3"
                       Style="{StaticResource CaptionStyle}"
                       Text="PRO KEY" />
            <TextBox x:Name="LicenseKeyTextBox"
                     Grid.Row="8"
                     Grid.Column="0"
                     FontFamily="Consolas"
                     FontSize="11" />
            <Button x:Name="ActivateProButton"
                    Grid.Row="8"
                    Grid.Column="2"
                    Content="Activate"
                    Click="ActivateProButton_OnClick" />
          </Grid>
        </Border>

        <Grid Grid.Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock x:Name="BoostDetailsTitleTextBlock" Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="Boost Details" />
              <Border Grid.Row="2" Style="{StaticResource InsetPanelStyle}" Padding="6">
                <ListBox ItemsSource="{Binding BoostDetails}"
                         FontFamily="Consolas"
                         FontSize="11" />
              </Border>
            </Grid>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock x:Name="RecentActivityTitleTextBlock" Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="Recent Activity" />
              <Border Grid.Row="2" Style="{StaticResource InsetPanelStyle}" Padding="6">
                <ListBox ItemsSource="{Binding RecentEvents}"
                         FontFamily="Consolas"
                         FontSize="11" />
              </Border>
              <TextBlock x:Name="LicenseStatusCaptionTextBlock"
                         Grid.Row="4"
                         Style="{StaticResource CaptionStyle}"
                         Text="LICENSE STATUS" />
              <TextBlock x:Name="LicenseStatusTextBlock"
                         Grid.Row="6"
                         Style="{StaticResource BodyTextStyle}" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
