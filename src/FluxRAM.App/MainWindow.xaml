<Window x:Class="FluxRAM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FluxRAM.App"
        Title="FluxRAM"
        Width="1060"
        Height="760"
        MinWidth="860"
        MinHeight="600"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="FluxRAM.ico"
        FontFamily="Segoe UI"
        Background="#0E1117"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <Window.Resources>
    <local:DetailTextConverter x:Key="DetailTextConverter" />
    <DataTemplate x:Key="ReadableEntryTemplate">
      <StackPanel>
        <TextBlock Text="{Binding Converter={StaticResource DetailTextConverter}, ConverterParameter=Title}"
                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Converter={StaticResource DetailTextConverter}, ConverterParameter=Body}"
                   FontSize="12" FontWeight="Normal" LineHeight="20" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="6,12" />
      <Setter Property="Margin" Value="8,0,8,8" />
      <Setter Property="Width" Value="72" />
      <Setter Property="MinHeight" Value="64" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="TabItem">
          <Border x:Name="TabRoot" BorderThickness="1" CornerRadius="6" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Background="Transparent">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" Margin="0,0,0,8" />
              <TextBlock Text="{TemplateBinding Header}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource ListItemHoverBrush}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E1117" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#121821" />
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#0D131A" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#243244" />
    <SolidColorBrush x:Key="InsetBorderBrush" Color="#243040" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F7FB" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D8E2F0" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#C4D0E2" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3DD6A3" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#18362B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F7C873" />
    <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="#0D141D" />
    <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#516B8D" />
    <SolidColorBrush x:Key="ComboBoxForegroundBrush" Color="#17202C" />
    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#EFF5FB" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#CAD5E2" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#1B2531" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#304156" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#223044" />
    <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#526A84" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#192331" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#3DD6A3" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#7BE8BC" />
    <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#06130D" />
    <SolidColorBrush x:Key="QuietButtonBackgroundBrush" Color="#151E29" />
    <SolidColorBrush x:Key="QuietButtonBorderBrush" Color="#2D3A49" />
    <SolidColorBrush x:Key="IconButtonBackgroundBrush" Color="#101923" />
    <SolidColorBrush x:Key="IconButtonBorderBrush" Color="#4B6280" />
    <SolidColorBrush x:Key="ToggleBackgroundBrush" Color="#1B2531" />
    <SolidColorBrush x:Key="ToggleBorderBrush" Color="#304156" />
    <SolidColorBrush x:Key="ToggleHoverBorderBrush" Color="#5C7087" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#253A31" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="#202B38" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#0E1117" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#3A4A5F" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#526A84" />
    <SolidColorBrush x:Key="IconTileBackgroundBrush" Color="#0D141D" />
    <SolidColorBrush x:Key="IconTileBorderBrush" Color="#2E3B4C" />
    <SolidColorBrush x:Key="EditionBadgeBorderBrush" Color="#315E4B" />
    <SolidColorBrush x:Key="EditionBadgeTextBrush" Color="#9FF0C9" />

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="InsetPanelStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource InsetBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="CaptionStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ValueStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style x:Key="MetricLineStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueStyle}">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="SelectionToggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="SelectionBorder" CornerRadius="5" BorderThickness="1" Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource BorderBrushSoft}">
                  <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
            <Border x:Name="ComboFocus" BorderThickness="1" BorderBrush="Transparent" CornerRadius="5" IsHitTestVisible="False" />
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="5"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4">
                <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFocus" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Option" Padding="{TemplateBinding Padding}" CornerRadius="4" Background="Transparent"><ContentPresenter /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="BaseButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonRoot"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}" />
    </Style>

    <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Background" Value="{DynamicResource QuietButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QuietButtonBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="DeepReleaseButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style x:Key="DeepReleaseLockedButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{DynamicResource IconButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />

    <Style x:Key="ToggleBoostStyle" TargetType="ToggleButton">
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ToggleRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5"
                    SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Margin="0,0,12,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
                <Border x:Name="SwitchTrack" Grid.Column="1" Width="38" Height="22" CornerRadius="11"
                        Background="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                  <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Fill="{DynamicResource PrimaryButtonTextBrush}" Margin="3" HorizontalAlignment="Left" />
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.8" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="SwitchTrack" Property="BorderThickness" Value="1" />
                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="AlternationCount" Value="2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemRoot"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource ListItemSelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource ListItemHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="16" />
      <Setter Property="Background" Value="{DynamicResource ScrollBarTrackBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track"
                     Orientation="{TemplateBinding Orientation}"
                     ViewportSize="NaN"
                     IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand"
                                Focusable="False"
                                Opacity="0" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb x:Name="ScrollThumb"
                         Width="16"
                         Height="40">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbRoot"
                                Margin="3"
                                CornerRadius="5"
                                Background="{DynamicResource ScrollBarThumbBrush}" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbRoot" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand"
                                Focusable="False"
                                Opacity="0" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                <Setter TargetName="ScrollThumb" Property="Width" Value="40" />
                <Setter TargetName="ScrollThumb" Property="Height" Value="16" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="16" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

<Grid Background="{DynamicResource SurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="8" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.RowSpan="4" Width="88" HorizontalAlignment="Left" Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource InsetBorderBrush}" BorderThickness="0,0,1,0" />
    <Grid Height="72">
      <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Image Source="FluxRAM.ico" Width="32" Height="32" />
      <StackPanel Grid.Column="1" Margin="24,0,16,0" VerticalAlignment="Center">
        <DockPanel>
          <TextBlock x:Name="AppTitleTextBlock" Text="FluxRAM" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="3" Padding="7,2" Margin="10,3,0,3" HorizontalAlignment="Left">
            <TextBlock x:Name="EditionValueTextBlock" Text="Free" FontSize="11" Foreground="{DynamicResource EditionBadgeTextBrush}" />
          </Border>
        </DockPanel>
        <TextBlock x:Name="AppSubtitleTextBlock" Style="{StaticResource BodyTextStyle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
        <Button x:Name="DetailSettingsButton" Width="36" Height="36" Padding="0" Margin="0,0,8,0" FontFamily="Segoe MDL2 Assets" Content="&#xE740;"
                Click="DetailSettingsButton_OnClick" ToolTip="Compact view" AutomationProperties.Name="Compact view" />
        <Button x:Name="ToolsMenuButton" Width="36" Height="36" Padding="0" FontFamily="Segoe MDL2 Assets" Content="&#xE712;"
                Click="ToolsMenuButton_OnClick" ToolTip="Tools" AutomationProperties.Name="Tools">
          <Button.ContextMenu><ContextMenu>
            <MenuItem x:Name="CheckUpdateMenuItem" Header="Check update" Click="CheckUpdateMenuItem_OnClick" />
            <MenuItem x:Name="ThemeMenuItem" Header="Light theme" Click="ThemeMenuItem_OnClick" />
            <Separator />
            <MenuItem x:Name="DiagnosticLogMenuItem" Header="Diagnostic log" Click="DiagnosticLogMenuItem_OnClick" />
            <MenuItem x:Name="GithubMenuItem" Header="GitHub" Click="GithubMenuItem_OnClick" />
          </ContextMenu></Button.ContextMenu>
        </Button>
      </StackPanel>
    </Grid>

    <TabControl x:Name="WorkspaceTabs" Grid.Row="2" Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource TextPrimaryBrush}" TabStripPlacement="Left" Padding="24,8,24,0">
      <TabControl.Template><ControlTemplate TargetType="TabControl">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" VerticalAlignment="Top" />
          <Border Grid.Column="1" Padding="{TemplateBinding Padding}" KeyboardNavigation.TabNavigation="Local">
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" TextElement.FontWeight="Normal" />
          </Border>
        </Grid>
      </ControlTemplate></TabControl.Template>
      <TabItem x:Name="OverviewTab" Header="Overview" Tag="&#xE80F;">
        <ScrollViewer x:Name="DetailPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" PreviewMouseWheel="DetailPanel_OnPreviewMouseWheel">
          <Grid Margin="0,0,6,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid x:Name="OverviewTopGrid">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
              <StackPanel x:Name="MemoryOverviewPanel">
                <TextBlock x:Name="MemoryMetricsTitleTextBlock" Text="Memory" Style="{StaticResource SectionTitleStyle}" />
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="124" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="AvailableCaptionTextBlock" Text="Available memory" Style="{StaticResource CaptionStyle}" />
                    <TextBlock x:Name="AvailableValueTextBlock" Text="{Binding AvailableRamValue}" FontSize="34" FontWeight="SemiBold" Margin="0,3,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding PhysicalMemoryDisplay}" Style="{StaticResource BodyTextStyle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                  </StackPanel>
                  <Grid Grid.Column="1" Width="120" Height="114">
                    <local:MemoryUsageGauge x:Name="MemoryGauge" Value="{Binding MemoryLoadPercent, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource InsetBorderBrush}" AutomationProperties.Name="{Binding MemoryLoadValue}" />
                    <StackPanel VerticalAlignment="Center" Margin="12,0,12,4">
                      <TextBlock Text="{Binding MemoryLoadValue}" FontSize="26" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                      <TextBlock x:Name="MemoryLoadCaptionTextBlock" Text="Memory load" Style="{StaticResource CaptionStyle}" TextAlignment="Center" FontSize="10" Margin="0,3,0,0" />
                    </StackPanel>
                  </Grid>
                </Grid>
                <Grid x:Name="TrendRegion" Margin="0,8,0,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="64" /></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock x:Name="TrendCaptionTextBlock" Grid.ColumnSpan="2" Text="Memory load · last 2 minutes" Style="{StaticResource CaptionStyle}" FontSize="11" Margin="0,0,0,6" />
                  <TextBlock Grid.Row="1" Text="100%" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                  <TextBlock Grid.Row="1" Text="0%" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" />
                  <local:MemoryTrend x:Name="MemoryTrendChart" Grid.Row="1" Grid.Column="1"
                                     LineBrush="{DynamicResource AccentBrush}" GridBrush="{DynamicResource InsetBorderBrush}" />
                </Grid>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="BoostNetGainCaptionTextBlock" Text="Available memory gain" Style="{StaticResource CaptionStyle}" />
                    <TextBlock x:Name="BoostNetGainValueTextBlock" Text="{Binding BoostNetGainValue}" Style="{StaticResource ValueStyle}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock x:Name="LastBoostTrimmedCaptionTextBlock" Text="Last working-set trim" Style="{StaticResource CaptionStyle}" />
                    <TextBlock x:Name="LastBoostTrimmedValueTextBlock" Text="{Binding LastBoostTrimmedValue}" Style="{StaticResource ValueStyle}" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock x:Name="RamDeltaCaptionTextBlock" Text="Available change since launch" Style="{StaticResource CaptionStyle}" />
                    <TextBlock x:Name="RamDeltaValueTextBlock" Text="{Binding RamDeltaValue}" Style="{StaticResource ValueStyle}" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                    <TextBlock x:Name="TotalTrimmedCaptionTextBlock" Text="Working-set trim this session" Style="{StaticResource CaptionStyle}" />
                    <TextBlock x:Name="TotalTrimmedValueTextBlock" Text="{Binding TotalTrimmedValue}" Style="{StaticResource ValueStyle}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
              <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource InsetBorderBrush}" Padding="24,0,0,0">
              <StackPanel>
                <TextBlock x:Name="RuntimeSummaryTitleTextBlock" Text="Optimization" Style="{StaticResource SectionTitleStyle}" />
                <Grid Margin="0,8,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock x:Name="ProfileCaptionTextBlock" Text="Profile" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                  <Button x:Name="ProfileHelpButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="?" Click="ProfileHelpButton_OnClick" />
                </Grid>
                <ComboBox x:Name="ProfileSelector" SelectionChanged="ProfileSelector_OnSelectionChanged" AutomationProperties.LabeledBy="{Binding ElementName=ProfileCaptionTextBlock}">
                  <ComboBoxItem x:Name="ConservativeProfileItem" Tag="Conservative" Content="Daily" />
                  <ComboBoxItem x:Name="GamingHandheldProfileItem" Tag="GamingHandheld" Content="Gaming" />
                  <ComboBoxItem x:Name="AggressiveProfileItem" Tag="Aggressive" Content="Extreme" Visibility="Collapsed" />
                </ComboBox>
                <Button x:Name="BoostNowButton" Height="40" Margin="0,12,0,0" FontSize="14" Style="{StaticResource PrimaryButtonStyle}"
                        Content="Boost now" Click="BoostNowButton_OnClick" />
                <ToggleButton x:Name="AutoBoostToggle" Margin="0,8,0,0" Style="{StaticResource ToggleBoostStyle}"
                              Content="Auto Boost" Checked="AutoBoostToggle_OnChecked" Unchecked="AutoBoostToggle_OnUnchecked" />
                <Button x:Name="DeepReleaseButton" Height="38" Margin="0,8,0,0" Content="Deep Release"
                        Style="{StaticResource DeepReleaseButtonStyle}" Click="DeepReleaseButton_OnClick" />
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource InsetBorderBrush}" Margin="0,12,0,6" />
                <TextBlock Text="{Binding ReboundRateDisplay}" Style="{StaticResource BodyTextStyle}" FontSize="12" Margin="0,4,0,0" />
                <TextBlock Text="{Binding ProcessSummaryDisplay}" Style="{StaticResource BodyTextStyle}" FontSize="12" Margin="0,4,0,0" />
                <TextBlock Text="{Binding ForegroundProcessDisplay}" Style="{StaticResource BodyTextStyle}" FontSize="12" Margin="0,4,0,0" />
              </StackPanel>
              </Border>
            </Grid>
            <Grid x:Name="ResultsRegion" Grid.Row="2" Margin="0,12,0,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <DockPanel Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="ViewBoostDetailsButton" Content="Details" Click="ViewBoostDetailsButton_OnClick" Margin="0,0,8,0" />
                  <Button x:Name="PreviewBoostCandidatesButton" Content="Preview" Click="PreviewBoostCandidatesButton_OnClick" />
                </StackPanel>
                <TextBlock x:Name="BoostDetailsTitleTextBlock" Text="Boost results" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock x:Name="BoostEmptyTextBlock" Grid.Row="1" Margin="0,14" Text="No Boost results yet.">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding BoostDetails.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
              </TextBlock>
              <ListBox x:Name="BoostDetailsListBox" Grid.Row="2" ItemsSource="{Binding BoostDetails}" MaxHeight="240" Margin="0,10,0,0"
                       ItemTemplate="{StaticResource ReadableEntryTemplate}" MouseDoubleClick="DetailListBox_OnMouseDoubleClick"
                       KeyDown="DetailListBox_OnKeyDown" PreviewMouseWheel="DetailListBox_OnPreviewMouseWheel" />
            </Grid>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="ProtectionTab" Header="App protection" Tag="&#xE73E;">
        <Grid x:Name="ProtectedAppsCard">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DockPanel>
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
              <Button x:Name="AddProtectedAppButton" Content="Add EXE" Click="AddProtectedAppButton_OnClick" />
              <Button x:Name="AddRunningProtectedAppButton" Content="Running app" Click="AddRunningProtectedAppButton_OnClick" Margin="8,0,0,0" />
              <Button x:Name="RemoveProtectedAppButton" Content="Remove selected" Click="RemoveProtectedAppButton_OnClick" Margin="8,0,0,0" />
            </WrapPanel>
            <TextBlock x:Name="ProtectListTitleTextBlock" Text="Protected apps" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock x:Name="ProtectionModeTextBlock" Grid.Row="1" Margin="0,14" Style="{StaticResource BodyTextStyle}" />
          <Border x:Name="ProtectListEditorBorder" Grid.Row="2">
            <ListBox x:Name="ProtectedAppsListBox" ItemsSource="{Binding ProtectedEntries}" SelectionMode="Extended"
                     ItemTemplate="{StaticResource ReadableEntryTemplate}" SelectionChanged="ProtectedAppsListBox_OnSelectionChanged"
                     MouseDoubleClick="DetailListBox_OnMouseDoubleClick" KeyDown="DetailListBox_OnKeyDown"
                     PreviewMouseWheel="DetailListBox_OnPreviewMouseWheel" />
          </Border>
          <Border x:Name="ProtectListLockedBorder" Grid.Row="2" Visibility="Collapsed">
            <TextBlock x:Name="ProtectListLockedTextBlock" Text="App protection" TextWrapping="Wrap"
                       Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="ViewProtectionDetailsButton" DockPanel.Dock="Right" Content="Details" Click="ViewProtectionDetailsButton_OnClick" />
            <TextBlock x:Name="ProProtectionSummaryTextBlock" Text="{Binding ProProtectionSummaryDisplay}" TextWrapping="Wrap"
                       Foreground="{DynamicResource EditionBadgeTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
          </DockPanel>
        </Grid>
      </TabItem>

      <TabItem x:Name="ActivityTab" Header="Recent activity" Tag="&#xE81C;">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <Button x:Name="ViewActivityDetailsButton" DockPanel.Dock="Right" Content="Details" Click="ViewActivityDetailsButton_OnClick" />
            <TextBlock x:Name="RecentActivityTitleTextBlock" Text="Recent activity" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
          </DockPanel>
          <ListBox x:Name="RecentEventsListBox" Grid.Row="1" ItemsSource="{Binding RecentEvents}" ItemTemplate="{StaticResource ReadableEntryTemplate}"
                   MouseDoubleClick="DetailListBox_OnMouseDoubleClick" KeyDown="DetailListBox_OnKeyDown"
                   PreviewMouseWheel="DetailListBox_OnPreviewMouseWheel" />
        </Grid>
      </TabItem>

      <TabItem x:Name="SettingsTab" Header="Settings" Tag="&#xE713;">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="DetailPanel_OnPreviewMouseWheel">
          <StackPanel Margin="0,0,16,0">
            <TextBlock x:Name="PreferencesTitleTextBlock" Text="Preferences" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock x:Name="LanguageCaptionTextBlock" Text="Language" Style="{StaticResource CaptionStyle}" Margin="0,18,0,6" />
            <ComboBox x:Name="LanguageSelector" MaxWidth="360" HorizontalAlignment="Left" MinWidth="240"
                      SelectionChanged="LanguageSelector_OnSelectionChanged" AutomationProperties.LabeledBy="{Binding ElementName=LanguageCaptionTextBlock}">
              <ComboBoxItem x:Name="LanguageEnglishItem" Tag="en" Content="English" />
              <ComboBoxItem x:Name="LanguageChineseSimplifiedItem" Tag="zh-CN" Content="简体中文" />
              <ComboBoxItem x:Name="LanguageChineseTraditionalItem" Tag="zh-TW" Content="繁體中文" />
              <ComboBoxItem x:Name="LanguageJapaneseItem" Tag="ja" Content="日本語" />
              <ComboBoxItem x:Name="LanguageKoreanItem" Tag="ko" Content="한국어" />
            </ComboBox>
            <CheckBox x:Name="StartupAutoBoostCheckBox" Margin="0,20,0,6" Style="{StaticResource SettingsCheckBoxStyle}"
                      Content="Start with Windows" Checked="StartupAutoBoostCheckBox_OnChecked" Unchecked="StartupAutoBoostCheckBox_OnUnchecked" />
            <TextBlock x:Name="StartupAutoBoostStatusTextBlock" Style="{StaticResource BodyTextStyle}" />
            <DockPanel Margin="0,28,0,12">
              <Button x:Name="EditionHelpButton" DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="?" Click="EditionHelpButton_OnClick" />
              <TextBlock x:Name="EditionCaptionTextBlock" Text="Edition" Style="{StaticResource SectionTitleStyle}" />
            </DockPanel>
            <TextBlock x:Name="LicenseStatusCaptionTextBlock" Text="License status" Style="{StaticResource CaptionStyle}" />
            <TextBlock x:Name="LicenseStatusTextBlock" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,14" />
            <TextBlock x:Name="MachineIdCaptionTextBlock" Text="Machine ID" Style="{StaticResource CaptionStyle}" />
            <DockPanel Margin="0,6,0,14">
              <Button x:Name="CopyMachineIdButton" DockPanel.Dock="Right" Content="Copy" Click="CopyMachineIdButton_OnClick" Margin="8,0,0,0" />
              <TextBox x:Name="MachineIdTextBox" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.LabeledBy="{Binding ElementName=MachineIdCaptionTextBlock}" />
            </DockPanel>
            <TextBlock x:Name="LicenseKeyCaptionTextBlock" Text="Pro Key" Style="{StaticResource CaptionStyle}" />
            <DockPanel Margin="0,6,0,14">
              <Button x:Name="ActivateProButton" DockPanel.Dock="Right" Content="Activate" Click="ActivateProButton_OnClick" Margin="8,0,0,0" />
              <TextBox x:Name="LicenseKeyTextBox" FontFamily="Consolas" AutomationProperties.LabeledBy="{Binding ElementName=LicenseKeyCaptionTextBlock}" />
            </DockPanel>
            <TextBlock x:Name="SelfOverheadCaptionTextBlock" Text="App overhead" Style="{StaticResource CaptionStyle}" Margin="0,14,0,4" />
            <TextBlock x:Name="SelfOverheadValueTextBlock" Text="{Binding SelfOverheadDisplay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" TextTrimming="None" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource InsetBorderBrush}" Margin="112,14,24,0" Padding="0,10,0,12">
      <DockPanel>
        <TextBlock Text="{Binding LastUpdatedDisplay}" DockPanel.Dock="Right" Style="{StaticResource BodyTextStyle}" FontSize="11" Margin="16,0,0,0" />
        <TextBlock x:Name="StatusCaptionTextBlock" DockPanel.Dock="Left" Style="{StaticResource CaptionStyle}" Text="Status" Margin="0,0,8,0" />
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyTextStyle}" FontSize="12" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
