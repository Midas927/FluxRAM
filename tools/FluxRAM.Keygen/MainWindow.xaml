<Window x:Class="FluxRAM.Keygen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluxRAM Pro Key Generator"
        Width="760"
        Height="460"
        MinWidth="760"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="FluxRAM.ico"
        FontFamily="Segoe UI">
  <Window.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#101524" Offset="0.0" />
      <GradientStop Color="#182132" Offset="1.0" />
    </LinearGradientBrush>
  </Window.Background>

  <Window.Resources>
    <Style x:Key="CaptionStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A8BCD6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="InputStyle" TargetType="TextBox">
      <Setter Property="Height" Value="30" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Foreground="#F3F7FF" FontSize="24" FontWeight="Bold" Text="FluxRAM Pro Key Generator" />
      <TextBlock Margin="0,6,0,0"
                 Foreground="#B9CAE0"
                 FontSize="13"
                 TextWrapping="Wrap"
                 Text="Internal tool. Enter the user's Machine ID, load the private key, then generate a Pro activation key." />
    </StackPanel>

    <Border Grid.Row="2"
            CornerRadius="8"
            Padding="14"
            BorderThickness="1"
            BorderBrush="#334E6B"
            Background="#55212A3D">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="6" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="12" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="6" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource CaptionStyle}" Text="PRIVATE KEY XML" />
        <TextBox x:Name="PrivateKeyPathTextBox"
                 Grid.Row="2"
                 Grid.Column="0"
                 Style="{StaticResource InputStyle}" />
        <Button Grid.Row="2"
                Grid.Column="2"
                Content="Browse"
                Click="BrowsePrivateKeyButton_OnClick" />

        <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource CaptionStyle}" Text="USER MACHINE ID" />
        <TextBox x:Name="MachineIdTextBox"
                 Grid.Row="6"
                 Grid.ColumnSpan="3"
                 Style="{StaticResource InputStyle}" />
      </Grid>
    </Border>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="132" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusTextBlock"
                 Grid.Column="0"
                 VerticalAlignment="Center"
                 Foreground="#B9CAE0"
                 TextWrapping="Wrap" />
      <Button x:Name="GenerateButton"
              Grid.Column="2"
              Height="34"
              FontWeight="Bold"
              Content="Generate Key"
              Click="GenerateButton_OnClick" />
    </Grid>

    <Border Grid.Row="6"
            CornerRadius="8"
            Padding="14"
            BorderThickness="1"
            BorderBrush="#334E6B"
            Background="#33101824">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource CaptionStyle}" Text="PRO KEY" />
        <TextBox x:Name="GeneratedKeyTextBox"
                 Grid.Row="2"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12" />
      </Grid>
    </Border>

    <Grid Grid.Row="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="110" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 VerticalAlignment="Center"
                 Foreground="#8FA5C1"
                 FontSize="11"
                 Text="Never send this tool or the private key to users." />
      <Button Grid.Column="1"
              Height="30"
              Content="Copy Key"
              Click="CopyKeyButton_OnClick" />
      <Button Grid.Column="3"
              Height="30"
              Content="Clear"
              Click="ClearButton_OnClick" />
    </Grid>
  </Grid>
</Window>
